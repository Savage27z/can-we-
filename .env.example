# Copy this file to .env and fill in your own values. .env is gitignored.
# On Railway, set these as service variables instead; there is no .env in the container.
#
# OANDA: open a free demo (practice) account, then in the OANDA Hub go to
# Tools -> API and generate a personal access token. A practice-account token is
# sufficient for historical candle data.

OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Get a DeepSeek API key at https://platform.deepseek.com/api_keys
# Used only to format/narrate already-computed structured signal data (Phase 4) —
# it never decides bias, levels, or trade direction; that's all computed
# deterministically by backtest/ and live/ before the LLM ever sees anything.
DEEPSEEK_API_KEY=

# Create a bot with @BotFather to get a token. Anyone who can message the bot can trigger
# paid API calls, so TELEGRAM_ALLOWED_CHAT_IDS restricts it to your own chat(s)
# (comma-separated numeric chat IDs; message the bot /start to learn yours).
#
# Only ONE process may poll a given bot token at a time. Use a separate bot (a second
# token from @BotFather) for local runs, or stop the deployed service first; otherwise
# the two instances split incoming messages and both send alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Where candle data, the news cache and the sent-alerts log are stored. Defaults to
# ./data. On Railway set this to the mount path of an attached volume (e.g. /data);
# without a volume the data is wiped on every deploy and recent alerts get re-sent.
DATA_DIR=
